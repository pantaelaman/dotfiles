{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "poweradapter",
    "break",
    "colors"
  ],
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/archlogo_stripes",
    "color": {
      "1": "#078d70",
      "2": "#98e8c1",
      "3": "#ffffff",
      "4": "#7bade2",
      "5": "#3d1a78"
    }
  }
}
